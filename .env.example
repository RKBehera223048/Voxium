# =============================================================================
# Voxium — Local Privacy-First Voice Assistant Configuration
# =============================================================================
# Copy this file to .env and customize for your setup:
#   cp .env.example .env

# ── General ──────────────────────────────────────────────────────────────────
VOXIUM_HOST=127.0.0.1
VOXIUM_PORT=5000
VOXIUM_DEBUG=false

# Generate a unique secret key:
#   python -c "import secrets; print(secrets.token_hex(32))"
VOXIUM_SECRET_KEY=REPLACE_ME_WITH_RANDOM_SECRET

# Set a passphrase to enable session-based auth (C-6).
# When empty/unset, Voxium runs in open local mode (127.0.0.1 only).
# VOXIUM_LOCAL_PASSPHRASE=your-local-passphrase-here

# Allowed CORS origins (comma-separated). Restricts which sites can call the API.
VOXIUM_ALLOWED_ORIGINS=http://127.0.0.1:5000

# ── Agent ────────────────────────────────────────────────────────────────────
AGENT_NAME=Voxium
AGENT_ENABLED=true

# ── Speech-to-Text Engine ───────────────────────────────────────────────────
# Options: whisper | parakeet
STT_ENGINE=whisper
WHISPER_MODEL_SIZE=base
WHISPER_MODEL_DIR=models/stt

# ── VAD (Voice Activity Detection) ──────────────────────────────────────────
VAD_SILENCE_RMS_THRESHOLD=0.002
VAD_SPEECH_WINDOW_RMS_THRESHOLD=0.003
VAD_SPEECH_WINDOW_PEAK_THRESHOLD=0.02
VAD_STRONG_SPEECH_RMS_THRESHOLD=0.006
VAD_SILERO_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION_MS=300
VAD_MIN_SILENCE_DURATION_MS=100

# ── Local LLM (Reasoning / Agent Mode) ─────────────────────────────────────
LLM_MODEL_PATH=models/llm/model.gguf
LLM_CONTEXT_LENGTH=4096
LLM_NUM_THREADS=4
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ── Text Cleanup ────────────────────────────────────────────────────────────
CLEANUP_ENABLED=true
CLEANUP_MODEL_PATH=

# ── Speaker Diarization ─────────────────────────────────────────────────────
DIARIZATION_ENABLED=false
HF_AUTH_TOKEN=
DIARIZATION_DEVICE=cpu
SPEAKER_MATCH_THRESHOLD=0.65
SPEAKER_MATCH_MARGIN=0.03
SPEAKER_MAX_COUNT=10

# ── TTS (Text-to-Speech) ───────────────────────────────────────────────────
TTS_ENABLED=false
TTS_MODEL_DIR=models/tts

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_PATH=data/db/voxium.sqlite

# ── Language ────────────────────────────────────────────────────────────────
PREFERRED_LANGUAGE=en

# ── Custom Dictionary ──────────────────────────────────────────────────────
CUSTOM_DICTIONARY=

# ── Graph-RAG Memory ───────────────────────────────────────────────────────
GRAPH_DB_PATH=data/db/graph.json
GRAPH_CONTEXT_MAX_TOKENS=500
GRAPH_AUTO_CLUSTER=true
